# Production environment variables
# Copy this file to .env.prod and fill in real values. Never commit real secrets.

NODE_ENV=production
APP_RUNTIME_MODE=production
AUTH_MODE=real
SEARCH_MODE=atlas
STORAGE_MODE=provider
CACHE_MODE=redis
QUEUE_MODE=redis
USE_REAL_API=true
USE_REAL_DB=true
USE_REAL_AUTH=true
USE_REAL_SEARCH=true
MFA_MODE=required

ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_CONSENT_MANAGEMENT=true
ENABLE_COOKIE_CONSENT_BANNER=true
ENABLE_DSR_WORKFLOWS=true
ENABLE_GDPR_MODE=true
ENABLE_DPDP_MODE=true
ENABLE_DATA_RETENTION_JOBS=true
ENABLE_BREACH_NOTIFICATION_WORKFLOW=true
DATA_RESIDENCY_REGION=IN
CHILDREN_DATA_PROTECTION_MODE=false

PORT=4000
WORKER_PORT=4001
WORKER_ENABLE_HEALTH_HTTP=false

# Domains & subdomains
PUBLIC_DOMAIN_ROOT=yourdomain.com
ENV_SUBDOMAIN_PREFIX=
MARKETPLACE_HOST=yourdomain.com
SELLER_HOST=seller.yourdomain.com
ADMIN_HOST=admin.yourdomain.com
API_HOST=api.yourdomain.com
MEDIA_HOST=media.yourdomain.com
SSL_CERT_MODE=shared

# Secrets — fill in real values
MONGODB_URI=PLACEHOLDER_MONGODB_URI
REDIS_URL=PLACEHOLDER_REDIS_URL
NEXTAUTH_SECRET=PLACEHOLDER_NEXTAUTH_SECRET
STORAGE_ACCESS_KEY=PLACEHOLDER_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=PLACEHOLDER_STORAGE_SECRET_KEY
STORAGE_BUCKET=PLACEHOLDER_STORAGE_BUCKET
STORAGE_REGION=PLACEHOLDER_STORAGE_REGION
EMAIL_PROVIDER_KEY=PLACEHOLDER_EMAIL_KEY
